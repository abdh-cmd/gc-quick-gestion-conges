# Configuration MySQL/MariaDB locale (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=tempolis
# Mettre false en production ; utiliser alors des migrations.
DB_SYNCHRONIZE=true

# JWT : utiliser une valeur aléatoire longue et secrète en production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
